# BEGIN VietnamGuide Security Hardening
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# BEGIN VietnamGuide High-Performance Caching & Expired Headers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML dynamic documents: immediate validation / LiteSpeed cache managed
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"

    # Static CSS and JavaScript (cache-busted via sha256 query string)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Media, Fonts and Web Assets
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
# END VietnamGuide High-Performance Caching & Expired Headers

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Immediate 403 for scanner probes, hidden dotfiles & backups (0 PHP overhead)
    RewriteRule ^wp-content/\..* - [F,L]
    RewriteRule ^(\.env|\.git|\.user\.ini|wp-config\.php|readme\.html|license\.txt) - [F,L]
    RewriteRule \.(env|sql|bak|backup|config|save|swp|git|svn|bzr|hg|ini|log|tar\.gz|tgz|tsv)$ - [F,L]
    RewriteRule ^(app|apps|api|web|core|config|vendor)/\.env - [F,L]

    # 2. Block XML-RPC completely
    RewriteRule ^xmlrpc\.php$ - [F,L]

    # 3. Block malicious query string injections
    RewriteCond %{QUERY_STRING} (eval\(|base64_decode|GLOBALS|_SERVER) [NC]
    RewriteRule .* - [F,L]

    # 4. Protect wp-login.php against brute-force botnets
    # Allow if query has access=editorial OR existing logged-in cookie OR valid login referrer
    RewriteCond %{REQUEST_URI} ^/wp-login\.php$ [NC]
    RewriteCond %{QUERY_STRING} !access=editorial [NC]
    RewriteCond %{HTTP_COOKIE} !wordpress_logged_in_ [NC]
    RewriteCond %{HTTP_COOKIE} !wordpress_sec_ [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?vietnamguide\.net/wp-login\.php [NC]
    RewriteRule .* - [F,L]
</IfModule>
# END VietnamGuide Security Hardening

# BEGIN LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteRule litespeed/debug/.*\.log$ - [F,L]
RewriteRule \.litespeed_conf\.dat - [F,L]
</IfModule>
<IfModule LiteSpeed>
CacheLookup on
RewriteRule .* - [E=Cache-Control:no-autoflush]

### marker ASYNC start ###
RewriteCond %{REQUEST_URI} /wp-admin/admin-ajax\.php
RewriteCond %{QUERY_STRING} action=async_litespeed
RewriteRule .* - [E=noabort:1]
### marker ASYNC end ###

### marker DROPQS start ###
CacheKeyModify -qs:fbclid
CacheKeyModify -qs:gclid
CacheKeyModify -qs:utm*
CacheKeyModify -qs:_ga
### marker DROPQS end ###

</IfModule>
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END LSCACHE
# BEGIN NON_LSCACHE
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
## LITESPEED WP CACHE PLUGIN - Do not edit the contents of this block! ##
# END NON_LSCACHE
# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^terms/?$ /terms-of-service/ [R=301,L]
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
