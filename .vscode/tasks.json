    {
      "label": "Purge LiteSpeed Cache & Flush Rewrites",
      "type": "shell",
      "command": "python ops/run_remote.py \"wp --allow-root --path=/usr/local/lsws/vietnamguide.net/html rewrite flush && wp --allow-root --path=/usr/local/lsws/vietnamguide.net/html litespeed-purge all\"",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
