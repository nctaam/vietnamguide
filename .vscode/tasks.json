      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify Guide Experience (Mutations)",
      "type": "shell",
      "command": "pwsh -NoProfile -File ops/verify-guide-experience-mutations.ps1",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify Public Live HTTPS",
      "type": "shell",
      "command": "powershell -NoProfile -File ops/verify-guide-experience-public.ps1",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify Live Server (Remote WP-CLI)",
      "type": "shell",
      "command": "python ops/run_remote.py \"wp --allow-root --path=/usr/local/lsws/vietnamguide.net/html eval-file /usr/local/lsws/vietnamguide.net/html/ops/verify-guide-experience-live.php\"",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
