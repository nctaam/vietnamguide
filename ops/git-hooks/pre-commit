#!/usr/bin/env sh
# VietnamGuide Deployment Security Pre-Commit Hook
# Prevents committing deployment scripts that violate security policies.

echo "[pre-commit] Running deploy security audit scanner..."
python ops/deploy_security_audit.py --root ops --release-path deploy_theme_updates.py --strict-release

STATUS=$?
if [ $STATUS -ne 0 ]; then
    echo "[pre-commit] ERROR: Deploy security audit failed! Commit aborted."
    echo "[pre-commit] Ensure no deployment scripts contain hardcoded credentials or insecure policies."
    exit 1
fi

echo "[pre-commit] Running core contract unit tests..."
python -m unittest ops/tests/test_route_contract.py ops/tests/test_deploy_config.py ops/tests/test_deploy_security_audit.py -q

TEST_STATUS=$?
if [ $TEST_STATUS -ne 0 ]; then
    echo "[pre-commit] ERROR: Core contracts test failed! Commit aborted."
    exit 1
fi

echo "[pre-commit] All pre-commit security gates passed."
exit 0